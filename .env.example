# انسخ الملف ده باسم .env.local وحط القيم الحقيقية.
# الملف ده مش بيتحفظ في جيت — القيم دي أسرار.

# ===== سوبابيز =====
# من: Supabase Dashboard ← Project Settings ← API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الأدمن — بيعدّي فوق كل قواعد الحماية. للسيرفر بس، عمره ما يتحط
# في كود بيوصل للمتصفح. من: Project Settings ← API Keys ← Secret keys
SUPABASE_SERVICE_ROLE_KEY=

# ===== حارس المسارات المجدولة =====
# أي نص طويل عشوائي. لازم يبقى نفسه في:
#   • فيرسل (Environment Variables)
#   • المهمة المجدولة في قاعدة البيانات (شوف sql/cron-jobs.sql)
SYNC_KEY=

# ===== بوسطة =====
# ملحوظة: المفتاح ده للتجربة المحلية بس. السيستم الحقيقي بيقرا مفتاح كل
# بيزنس من جدول tenant_credentials مش من هنا.
# من: بوسطة ← ربط التطبيقات ← إنشاء مفتاح API (بيظهر مرة واحدة بس)
BOSTA_API_KEY=
